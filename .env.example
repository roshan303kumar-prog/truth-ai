# TRUTH AI Configuration File
# Copy this file to .env and adjust variables as needed

# Flask Secret Key for sessions (change in production)
SECRET_KEY=truth-ai-secure-dev-session-key-2026-xyz789

# Database URL (defaults to SQLite in database/truth_ai.db)
DATABASE_URL=sqlite:///database/truth_ai.db

# Optional Evidence Provider API Keys
# Google Fact Check Tools API Key (Free from Google Cloud Console)
GOOGLE_FACT_CHECK_API_KEY=

# NewsAPI Key (Optional, from newsapi.org)
NEWS_API_KEY=

# Provider switches (Defaults to enabled)
DUCKDUCKGO_ENABLED=True
WIKIPEDIA_ENABLED=True
OFFLINE_FALLBACK_ENABLED=True

# Forensic Analysis Settings
ELA_QUALITY=90
ELA_SCALE=15
MAX_VIDEO_FRAMES=12

# Multimodal AI Assistant (Screen Awareness & ChatGPT-like Assistant)
# Optional: Provide Google Gemini (recommended - free tier) or OpenAI API Key
# If left blank, the system automatically uses the intelligent on-device multimodal fallback engine
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ASSISTANT_MODEL=gemini-1.5-flash
